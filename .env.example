# ============================================
# SUPABASE CONFIGURATION
# ============================================
VITE_SUPABASE_URL="your supabase project url here"
VITE_SUPABASE_PUBLISHABLE_KEY="your supabase publishable key here"


# ============================================
# EMAILJS CONFIGURATION
# ============================================
# Get these from https://www.emailjs.com

# Your EmailJS Public Key (from Account → General)
VITE_EMAILJS_PUBLIC_KEY="your_public_key_here"

# Your Gmail Service ID (from Email Services)
VITE_EMAILJS_SERVICE_ID="gmail_service"
# OR use your custom service ID if you set it up differently

# Template IDs (from Email Templates)
VITE_EMAILJS_CUSTOMER_TEMPLATE_ID=order_confirmation_customer
VITE_EMAILJS_ADMIN_TEMPLATE_ID=order_confirmation_admin

# Admin email address where order notifications should be sent
VITE_ADMIN_EMAIL=your-admin-email@gmail.com

# Razorpay test key for client-side checkout
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx

# ============================================
# OPTIONAL: APP CONFIGURATION
# ============================================
VITE_APP_URL=http://localhost:5173
